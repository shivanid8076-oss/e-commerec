# Backend Environment Variables Example

# Server configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Replace user, password, dbname with your actual PostgreSQL credentials
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Authentication Secrets
# Generate a secure random string for JWT_SECRET in production
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="7d"

# Payment Gateway (Razorpay/Stripe) Keys (Optional but critical for checkout)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Email / Notification Secrets (For Nodemailer/Twilio)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Shipping API (Shiprocket) Secrets
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
SHIPROCKET_PICKUP_LOCATION="Primary"

# Admin Initial Setup (Used only for first-time seed scripts)
ADMIN_DEFAULT_EMAIL="admin@vastram.store"
ADMIN_DEFAULT_PASSWORD="secure_password"
